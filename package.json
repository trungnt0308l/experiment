{
  "name": "ai-security-incident-radar",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply ai-security-radar --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply ai-security-radar --remote --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test vitest.config.ts",
    "build": "wrangler deploy --dry-run --env dev --outdir .wrangler/build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "miniflare": "5.20261006.2-beta",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
